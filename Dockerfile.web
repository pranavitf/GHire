FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.json tsconfig.base.json ./
COPY lib/ lib/
COPY artifacts/interview-ai/package.json artifacts/interview-ai/
RUN pnpm install --frozen-lockfile

FROM deps AS builder
COPY artifacts/interview-ai/ artifacts/interview-ai/
ARG VITE_API_BASE_URL=/api
ARG VITE_GEMINI_API_KEY
ARG BASE_PATH=/
ENV BASE_PATH=${BASE_PATH}
ENV VITE_GEMINI_API_KEY=${VITE_GEMINI_API_KEY}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm --filter @workspace/interview-ai run build

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/interview-ai/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
